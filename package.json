{
  "name": "stet",
  "productName": "STET",
  "version": "0.23.3",
  "description": "A fast, minimal, dependable screenwriting application.",
  "type": "module",
  "main": "src/main/boot.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "bench": "node bench/core-bench.js",
    "perf": "electron . --perf-probe",
    "quick": "node --test \"test/*.test.js\" && node --test --test-concurrency=1 test/e2e/styles.e2e.js test/e2e/app.e2e.js test/e2e/cast.e2e.js test/e2e/caret.e2e.js test/e2e/theme.e2e.js",
    "e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.js\"",
    "postinstall": "node node_modules/electron/install.js",
    "exe": "node scripts/build-exe.js",
    "mac": "node scripts/build-mac.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "44.5.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0"
  }
}
