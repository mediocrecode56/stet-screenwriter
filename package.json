{
  "name": "stet",
  "productName": "STET",
  "version": "0.6.0",
  "description": "A fast, minimal, dependable screenwriting application.",
  "type": "module",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "bench": "node bench/core-bench.js",
    "perf": "electron . --perf-probe",
    "e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.js\"",
    "postinstall": "node node_modules/electron/install.js",
    "exe": "node scripts/build-exe.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "44.5.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0"
  }
}
